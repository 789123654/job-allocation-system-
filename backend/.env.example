# Copy to .env (never committed) and fill in real values. Two separate DB connections — see
# DEPLOYMENT.md §2 for why they must never be the same value.

# fastapi_app role only — least-privilege, no BYPASSRLS. What the running app uses.
# ?sslmode=verify-full is required (DEPLOYMENT.md's "3 legs of TLS" section, ASVS 12.3.1/12.3.2) —
# included here, not just in prose, so copy-pasting this file doesn't silently drop it.
DATABASE_URL=postgresql+psycopg://fastapi_app:CHANGE_ME@aws-region.pooler.supabase.com:5432/postgres?sslmode=verify-full

# Supabase's own admin connection. Alembic only — never used by the running app.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@aws-region.pooler.supabase.com:5432/postgres?sslmode=verify-full

SUPABASE_URL=https://your-project.supabase.co

# Bypasses RLS — Auth Admin API only (employee account creation/reset). Never sent to the frontend.
SUPABASE_SECRET_KEY=sb_secret_CHANGE_ME

# Tauri webview origin(s) — explicit allowlist, never "*" (API_SPEC.md §1).
CORS_ORIGINS=["https://tauri.localhost"]
