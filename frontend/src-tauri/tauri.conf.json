{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ca-practice-manager",
  "version": "0.1.0",
  "identifier": "com.cafirmtool.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CA Firm Practice Management",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:8000 https://*.supabase.co https://*.ingest.sentry.io",
        "font-src": "https://fonts.gstatic.com",
        "style-src": "'self' https://fonts.googleapis.com",
        "img-src": "'self' asset: http://asset.localhost data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
